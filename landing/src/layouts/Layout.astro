---
import '@fontsource/outfit/latin-300.css';
import '@fontsource/outfit/latin-400.css';
import '@fontsource/outfit/latin-500.css';
import '@fontsource/outfit/latin-600.css';
import '../styles/global.css';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import { organizationJsonLd, site } from '../data/site';

interface Props {
	title?: string;
	description?: string;
	ogImage?: string;
	canonical?: string | URL;
	organization?: boolean;
}

const {
	title = site.title,
	description = site.description,
	ogImage = site.ogImage,
	canonical = Astro.url,
	organization = false,
} = Astro.props;

const canonicalUrl = canonical instanceof URL ? canonical.href : new URL(canonical, Astro.site).href;
const ogImageUrl = new URL(ogImage, Astro.site).href;
const pageTitle = title === site.title || title.includes(site.name) ? title : `${title}   ${site.name}`;
const ogSiteName = `${site.name} · ${site.legalName}`;
const ogImageAlt = `${site.name} signage and steel structure projects by ${site.legalName}`;
const jsonLd = JSON.stringify(organizationJsonLd).replace(/</g, '\\u003c');
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" sizes="any" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<meta name="theme-color" content="#043982" />
		<meta name="generator" content={Astro.generator} />
		<title>{pageTitle}</title>
		<meta name="description" content={description} />
		<meta name="author" content={site.legalName} />
		<meta name="robots" content="index, follow" />
		<link rel="canonical" href={canonicalUrl} />
		<meta property="og:title" content={pageTitle} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={ogImageUrl} />
		<meta property="og:image:alt" content={ogImageAlt} />
		<meta property="og:url" content={canonicalUrl} />
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content={ogSiteName} />
		<meta property="og:locale" content="en_US" />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={pageTitle} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImageUrl} />
		{organization && <script type="application/ld+json" is:inline set:html={jsonLd} />}
	</head>
	<body>
		<Header />
		<main id="main">
			<slot />
		</main>
		<Footer />
		<script>
			import { startSectionReveal } from '../scripts/section-reveal';
			import { startImageLazy } from '../scripts/image-lazy';
			startSectionReveal();
			startImageLazy();
		</script>
	</body>
</html>
