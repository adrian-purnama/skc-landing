---
import Layout from '../../../layouts/Layout.astro';
import { findProject, loadProjects, type Project } from '../../../lib/projects';

export function getStaticPaths() {
	return loadProjects().map((project) => ({
		params: {
			category: project.category.slug,
			project: project.slug,
		},
		props: { project },
	}));
}

interface Props {
	project: Project;
}

const routed = Astro.props.project;
const project = findProject(routed.category.slug, routed.slug) ?? routed;
const photos = project.gallery.length > 0 ? project.gallery : [project.card];
---

<Layout
	title={`${project.title} signage project in ${project.place}   MARQ | Sumber Kreasi Cemerlang`}
	description={`${project.title} signage project in ${project.place} by MARQ (PT Sumber Kreasi Cemerlang) design, fabrication, and installation.`}
	ogImage={project.card.src}
>
	<section class="project section-soft" aria-labelledby="project-heading">
		<header class="hero">
			<img class="cover" src={project.card.src} alt="" width="1600" height="1000" fetchpriority="high" decoding="async" />
			<div class="wrap copy" data-reveal>
				<p class="crumbs text-muted">
					<a href="/projects">Projects</a>
					<span aria-hidden="true"> / </span>
					<a href={`/projects/${project.category.slug}`}>{project.category.label}</a>
				</p>
				<div class="intro">
					<div>
						<h1 id="project-heading">{project.title}</h1>
						<p class="place">{project.place}</p>
					</div>
					<div class="logo-slot">
						<img class="logo" src={project.logo.src} alt="" loading="lazy" decoding="async" />
					</div>
				</div>
			</div>
		</header>
		<article class="wrap">
			<div class="masonry" data-masonry data-reveal>
				{
					photos.map((image) => (
						<figure class="skeleton" data-skeleton-img>
							<img src={image.src} alt={image.alt} loading="lazy" decoding="async" />
						</figure>
					))
				}
			</div>
		</article>
	</section>
</Layout>

<script>
	import Macy from 'macy';

	document.querySelectorAll<HTMLElement>('[data-masonry]').forEach((container) => {
		const count = container.children.length;
		if (count === 0) return;
		Macy({
			container,
			trueOrder: true,
			waitForImages: true,
			margin: 16,
			columns: Math.min(3, count),
			breakAt: {
				960: Math.min(2, count),
				640: 1,
			},
		});
	});
</script>

<style>
	.project {
		padding-top: 0;
	}

	.hero {
		position: relative;
		display: flex;
		align-items: flex-end;
		min-height: clamp(28rem, 68vh, 42rem);
		margin-bottom: 0.5rem;
		overflow: hidden;
	}

	.cover {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center;
	}

	.hero::after {
		content: '';
		position: absolute;
		inset: 0;
		background: linear-gradient(
			to bottom,
			rgb(16 23 42 / 0.55) 0%,
			rgb(16 23 42 / 0.42) 38%,
			rgb(16 23 42 / 0.12) 64%,
			var(--color-surface-soft) 88%
		);
	}

	.copy {
		position: relative;
		z-index: 1;
		width: 100%;
		padding-bottom: 0.25rem;
	}

	.crumbs {
		margin-bottom: 1.25rem;
	}

	.crumbs a {
		color: inherit;
		text-decoration: none;
	}

	.crumbs a:hover {
		color: var(--color-accent);
	}

	.intro h1 {
		font-size: clamp(1.75rem, 3.5vw, 2.5rem);
		letter-spacing: -0.02em;
		line-height: 1.1;
	}

	.intro {
		display: flex;
		align-items: flex-end;
		justify-content: space-between;
		gap: clamp(1rem, 3vw, 2.5rem);
	}

	.logo-slot {
		display: flex;
		flex: 0 1 auto;
		justify-content: flex-end;
		align-items: center;
		min-width: 0;
		max-width: 40%;
	}

	.logo {
		height: auto;
		width: auto;
		max-height: 3.5rem;
		max-width: 100%;
		object-fit: contain;
		object-position: right center;
	}

	.place {
		margin-top: 0.4rem;
		color: var(--color-muted);
		font-size: 1.0625rem;
	}

	.masonry {
		margin-top: 2rem;
	}

	.masonry figure {
		margin: 0;
		overflow: hidden;
		border-radius: 0.875rem;
		min-height: 8rem;
		background: var(--color-surface);
	}

	.masonry img {
		width: 100%;
		height: auto;
		border-radius: 0.875rem;
		opacity: 0;
		transition: opacity 0.35s ease;
	}

	.masonry figure.is-loaded img {
		opacity: 1;
	}

	@media (prefers-reduced-motion: reduce) {
		.masonry img {
			transition: none;
			opacity: 1;
		}
	}
</style>
