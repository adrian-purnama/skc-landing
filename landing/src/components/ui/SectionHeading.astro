---
interface Props {
	id: string;
	title: string;
	lede?: string;
	layout?: 'stack' | 'split' | 'split-end' | 'center';
	showBar?: boolean;
	markId?: string;
}

const { id, title, lede, layout = 'stack', showBar = false, markId } = Astro.props;

const titleParts = title.split(/(\s{2,})/).flatMap((part, index, parts) => {
	if (/^\s{2,}$/.test(part)) return [{ gap: true as const }];
	if (!part) return [];
	const followsGap = index > 0 && /^\s{2,}$/.test(parts[index - 1] ?? '');
	return [{ text: followsGap ? ` ${part}` : part }];
});
const gapMark = titleParts.some((part) => 'gap' in part);
---

<div class:list={['block', layout]}>
	<h2 id={id}>
		{
			titleParts.map((part) =>
				'gap' in part ? (
					<span id={gapMark ? markId : undefined} class="gap" aria-hidden="true"></span>
				) : (
					part.text
				),
			)
		}
		{markId && !gapMark && <span id={markId} class="mark"></span>}
	</h2>
	{lede && <p class:list={['text-muted', 'lede', layout === 'center' && 'sub']}>{lede}</p>}
	{showBar && <div class="bar rule"></div>}
</div>

<style>
	.block.stack .lede {
		max-width: 26em;
		margin-top: 1rem;
		font-size: 1.125rem;
	}

	.block.split {
		display: flex;
		justify-content: space-between;
		align-items: end;
		gap: 1.5rem;
		flex-wrap: wrap;
	}

	.block.split .lede,
	.block.split-end .lede {
		max-width: 30em;
	}

	.block.split-end {
		display: flex;
		flex-direction: column;
		gap: 1rem;
	}

	@media (min-width: 54rem) {
		.block.split-end {
			flex-direction: row-reverse;
			justify-content: space-between;
			align-items: end;
			gap: 1.5rem;
		}

		.block.split-end h2 {
			text-align: right;
		}
	}

	.block.center {
		text-align: center;
	}

	.block.center .lede {
		margin-top: 0.75rem;
	}

	.rule {
		margin-top: 1.75rem;
		max-width: 22.5rem;
	}

	.mark {
		display: inline-block;
		width: 0;
		height: 0;
	}

	.gap {
		display: inline-block;
		width: 3em;
	}

	@media (min-width: 54rem) {
		.gap {
			width: 4.75em;
		}
	}
</style>
