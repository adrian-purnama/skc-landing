---
import type { TimelineItem } from '../../data/site';

interface Props {
	items: TimelineItem[];
}

const { items } = Astro.props;
---

<ol class="timeline">
	{
		items.map((item) => (
			<li class:list={{ now: item.current }} data-reveal>
				<span class="yr">{item.year}</span>
				<h3>{item.title}</h3>
				<p>{item.text}</p>
			</li>
		))
	}
</ol>

<style>
	.timeline {
		list-style: none;
		margin: 0;
		padding: 0;
		border-left: 3px solid var(--color-border);
	}

	.timeline li {
		position: relative;
		padding: 0 0 2.25rem 2rem;
	}

	.timeline li:last-child {
		padding-bottom: 0;
	}

	.timeline li::before {
		content: '';
		position: absolute;
		left: -9px;
		top: 0.375rem;
		width: 15px;
		height: 15px;
		border-radius: 50%;
		background: var(--color-surface);
		border: 3px solid var(--color-accent);
	}

	.timeline li.now::before {
		background: var(--color-accent);
	}

	.yr {
		font-size: 2rem;
		font-weight: 300;
		color: var(--color-accent);
		line-height: 1;
	}

	.timeline h3 {
		margin: 0.5rem 0 0.375rem;
	}
</style>
