---
interface Props {
	href?: string;
	variant?: 'primary' | 'outline';
	type?: 'button' | 'submit';
	class?: string;
}

const { href, variant = 'primary', type = 'button', class: className } = Astro.props;
const classes = ['btn', variant === 'primary' ? 'btn-primary' : 'btn-outline', className]
	.filter(Boolean)
	.join(' ');
---

{
	href ? (
		<a href={href} class={classes}>
			<slot />
		</a>
	) : (
		<button type={type} class={classes}>
			<slot />
		</button>
	)
}
