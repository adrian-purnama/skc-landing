---
interface Asset {
	src: string;
	alt: string;
}

interface Props {
	logo: Asset;
	image: Asset;
}

const { logo, image } = Astro.props;
---

<figure class="card skeleton" data-logo-card>
	<img class="photo" data-src={image.src} alt="" aria-hidden="true" decoding="async" />
	<img class="logo" src={logo.src} alt={logo.alt} loading="lazy" decoding="async" />
	<slot />
</figure>

<style>
	.card {
		position: relative;
		display: block;
		min-width: 0;
		margin: 0;
		overflow: hidden;
		border: 1px solid var(--color-border);
		border-radius: 0.875rem;
		background: var(--color-surface);
	}

	.photo {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		opacity: 0;
		filter: grayscale(1);
		transition: opacity 0.45s ease;
	}

	.logo {
		position: absolute;
		left: 50%;
		top: 42%;
		z-index: 1;
		width: auto;
		max-width: min(74%, 16rem);
		height: auto;
		max-height: 46%;
		object-fit: contain;
		transform: translate(-50%, -50%);
		opacity: 0;
		transition:
			opacity 0.45s ease,
			visibility 0s linear 0s;
	}

	.card.is-loaded .logo {
		opacity: 1;
	}

	.card:hover .photo.is-ready,
	:global(a:hover) .photo.is-ready,
	:global(a:focus-visible) .photo.is-ready {
		opacity: 1;
	}

	.card:hover.is-loaded:has(.photo.is-ready) .logo,
	:global(a:hover) .card.is-loaded:has(.photo.is-ready) .logo,
	:global(a:focus-visible) .card.is-loaded:has(.photo.is-ready) .logo {
		opacity: 0;
	}

	@media (prefers-reduced-motion: reduce) {
		.photo,
		.logo {
			transition: none;
		}
	}
</style>
