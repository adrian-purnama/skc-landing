---
import { story } from '../../data/site';
import SectionHeading from '../ui/SectionHeading.astro';
import Timeline from '../ui/Timeline.astro';
---

<section class="section-soft" id="about" aria-labelledby="about-heading">
	<div class="wrap grid">
		<SectionHeading id="about-heading" title={story.title} lede={story.subtitle} showBar markId="about-mark" />
		<div>
			<p class="about-copy" data-reveal>{story.copy}</p>
			<Timeline items={story.timeline} />
		</div>
	</div>
</section>

<style>
	.grid {
		display: grid;
		gap: clamp(2rem, 6vw, 6rem);
		align-items: start;
	}

	.about-copy {
		max-width: 36em;
		margin-bottom: 2.5rem;
		font-size: 1.1875rem;
		line-height: 1.65;
		color: var(--color-heading);
	}

	@media (min-width: 54rem) {
		.grid {
			grid-template-columns: 1fr 1.3fr;
		}
	}
</style>
