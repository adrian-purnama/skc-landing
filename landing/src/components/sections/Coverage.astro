---
import { coverage } from '../../data/site';
import Media from '../ui/Media.astro';
import SectionHeading from '../ui/SectionHeading.astro';
---

<section id="coverage" aria-labelledby="coverage-heading">
	<div class="wrap grid">
		<div>
			<SectionHeading id="coverage-heading" title={coverage.title} lede={coverage.lede} />
			<ul class="cities" data-reveal>
				{coverage.cities.map((city) => <li>{city}</li>)}
			</ul>
		</div>
		<div class="map" data-reveal>
			<Media image={coverage.image} width={1300} height={455} />
		</div>
	</div>
</section>

<style>
	.grid {
		display: grid;
		gap: clamp(1.5rem, 5vw, 4.5rem);
		align-items: center;
	}

	.cities {
		list-style: none;
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		margin: 1.75rem 0 0;
		padding: 0;
	}

	.cities li {
		padding: 0.375rem 0.875rem;
		border-radius: 999px;
		background: var(--color-surface-soft);
		color: var(--color-heading);
		font-size: 0.90625rem;
	}

	.map {
		overflow: hidden;
		border-radius: 1.125rem;
		background: var(--color-surface);
	}

	.map :global(img) {
		width: 100%;
		height: auto;
	}

	@media (min-width: 54rem) {
		.grid {
			grid-template-columns: 1fr 1.5fr;
		}
	}
</style>
