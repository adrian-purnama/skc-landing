---
import { values } from '../../data/site';
import SectionHeading from '../ui/SectionHeading.astro';
---

<section id="values" aria-labelledby="values-heading">
	<div class="wrap">
		<SectionHeading id="values-heading" title={values.title} lede={values.lede} layout="split-end" markId="value-mark"/>
		<div class="values">
			{
				values.items.map((item) => (
					<article class="value" data-reveal>
						<div class="letter" aria-hidden="true">
							{item.letter}
						</div>
						<h3>{item.title}</h3>
						<p>{item.text}</p>
					</article>
				))
			}
		</div>
	</div>
</section>

<style>
	.values {
		display: grid;
		margin-top: 3.5rem;
		border-top: 1px solid var(--color-border);
	}

	.value {
		padding: 2rem 0 0.5rem;
		border-bottom: 1px solid var(--color-border);
	}

	.letter {
		font-weight: 500;
		font-size: clamp(5.5rem, 10vw, 8.75rem);
		line-height: 0.9;
		color: var(--color-primary);
	}

	.value h3 {
		margin: 1.25rem 0 0.625rem;
	}

	.value p {
		font-size: 0.96875rem;
	}

	@media (min-width: 32.5rem) {
		.values {
			grid-template-columns: 1fr 1fr;
		}

		.value:nth-child(odd) {
			margin-right: 1.75rem;
			padding-right: 1.75rem;
			border-right: 1px solid var(--color-border);
		}
	}

	@media (min-width: 56.25rem) {
		.values {
			grid-template-columns: repeat(4, 1fr);
		}

		.value,
		.value:nth-child(odd) {
			margin-right: 1.75rem;
			padding: 2rem 1.75rem 0.5rem 0;
			border-right: 1px solid var(--color-border);
			border-bottom: 0;
		}

		.value:last-child {
			margin-right: 0;
			padding-right: 0;
			border-right: 0;
		}
	}
</style>
