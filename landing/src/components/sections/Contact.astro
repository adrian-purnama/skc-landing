---
import { contact, offices, site } from '../../data/site';
---

<section class="section-dark" id="contact" aria-labelledby="contact-heading">
	<div class="wrap grid">
		<div data-reveal>
			<a class="wordmark" href="/#top">
				<img src="/marq%20logo%20white.png" alt={site.name} width="2038" height="859" />
			</a>
			<h2 id="contact-heading">{contact.title}</h2>
			<a class="mail" href={`mailto:${site.email}`}>{site.email}</a>
			<div class="offices">
				{
					offices.map((office) => (
						<div>
							<h3>{office.city}</h3>
							<address>
								{office.lines[0]}
								<br />
								{office.lines[1]}
							</address>
						</div>
					))
				}
			</div>
		</div>
		<form action={`mailto:${site.email}`} method="post" enctype="text/plain" data-reveal>
			<h3>{contact.formTitle}</h3>
			<div class="two">
				<label>
					Name
					<input name="name" required autocomplete="name" />
				</label>
				<label>
					Company
					<input name="company" autocomplete="organization" />
				</label>
			</div>
			<div class="two">
				<label>
					Email
					<input name="email" type="email" required autocomplete="email" />
				</label>
				<label>
					Phone
					<input name="phone" type="tel" autocomplete="tel" />
				</label>
			</div>
			<label class="select-field">
				Service
				<span class="select-wrap">
					<select name="service">
						{contact.services.map((service) => <option>{service}</option>)}
					</select>
				</span>
			</label>
			<label>
				Project location
				<input name="loc" placeholder="City" />
			</label>
			<label>
				Tell us about the project
				<textarea name="msg" rows="4"></textarea>
			</label>
			<button class="btn submit" type="submit">Send request</button>
		</form>
	</div>
</section>

<style>
	.grid {
		display: grid;
		gap: clamp(2rem, 6vw, 6rem);
	}

	.wordmark {
		position: relative;
		display: block;
		width: min(100%, 11.5rem);
		aspect-ratio: 1762 / 508;
		overflow: hidden;
		margin-bottom: 1.5rem;
		line-height: 0;
	}

	.wordmark img {
		position: absolute;
		width: 115.66%;
		height: 169.09%;
		max-width: none;
		left: -7.83%;
		top: -32.68%;
	}

	.mail {
		display: inline-block;
		margin-top: 1.5rem;
		font-size: clamp(1.125rem, 2vw, 1.375rem);
		color: var(--color-on-dark);
		text-underline-offset: 0.375rem;
	}

	.offices {
		display: grid;
		gap: 1.5rem;
		margin-top: 2.5rem;
	}

	.offices h3 {
		margin-bottom: 0.25rem;
		font-size: 1rem;
	}

	.offices address {
		font-style: normal;
		font-size: 0.9375rem;
		line-height: 1.55;
	}

	form {
		display: grid;
		gap: 1rem;
		align-self: start;
		padding: clamp(1.25rem, 3vw, 2.25rem);
		border: 1px solid color-mix(in srgb, var(--color-on-dark) 14%, transparent);
		border-radius: 1.25rem;
		background: color-mix(in srgb, var(--color-on-dark) 6%, transparent);
	}

	form h3 {
		margin-bottom: 0.25rem;
		font-size: 1.375rem;
	}

	label {
		display: grid;
		gap: 0.375rem;
		font-size: 0.875rem;
		color: var(--color-on-dark-muted);
	}

	input,
	select,
	textarea {
		width: 100%;
		padding: 0.75rem 0.875rem;
		border: 1.5px solid color-mix(in srgb, var(--color-on-dark) 20%, transparent);
		border-radius: 0.625rem;
		background: color-mix(in srgb, var(--color-heading) 18%, transparent);
		color: var(--color-on-dark);
		font: 1rem var(--font-sans);
		transition:
			border-color 0.2s ease,
			background-color 0.2s ease;
	}

	input:hover,
	select:hover,
	textarea:hover {
		border-color: color-mix(in srgb, var(--color-on-dark) 36%, transparent);
	}

	input:focus,
	select:focus,
	textarea:focus {
		outline: none;
		border-color: color-mix(in srgb, var(--color-on-dark) 55%, transparent);
		background: color-mix(in srgb, var(--color-heading) 28%, transparent);
	}

	.select-wrap {
		position: relative;
		display: block;
	}

	.select-wrap::after {
		content: '';
		position: absolute;
		top: 50%;
		right: 0.95rem;
		width: 0.55rem;
		height: 0.55rem;
		border-right: 1.5px solid var(--color-on-dark-muted);
		border-bottom: 1.5px solid var(--color-on-dark-muted);
		transform: translateY(-65%) rotate(45deg);
		pointer-events: none;
	}

	select {
		appearance: none;
		padding-right: 2.5rem;
		cursor: pointer;
	}

	select option {
		color: var(--color-heading);
		background: var(--color-surface);
	}

	.two {
		display: grid;
		gap: 1rem;
	}

	.submit {
		justify-self: start;
		background: var(--color-on-dark);
		color: var(--color-primary);
	}

	.submit:hover {
		background: color-mix(in srgb, var(--color-on-dark) 88%, var(--color-primary));
	}

	@media (min-width: 54rem) {
		.grid,
		.two {
			grid-template-columns: 1fr 1fr;
		}

		.wordmark {
			width: 13rem;
		}
	}
</style>
